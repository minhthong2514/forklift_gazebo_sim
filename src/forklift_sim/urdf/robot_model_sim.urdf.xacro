<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="forklift_mecanum">

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_x"      value="0.205"/>
  <xacro:property name="wheel_y"      value="0.1915"/>
  <xacro:property name="wheel_z"      value="-0.000429"/>
  <xacro:property name="ground_mu"    value="0.01"/>
  <xacro:property name="zed_height"   value="0.03"/>
  <xacro:property name="zed_slope"    value="0.05"/>

  <xacro:include filename="$(find zed_description)/urdf/zed_macro.urdf.xacro"/>

  <link name="base_footprint"/>

  <link name="chassis_link">
    <inertial>
      <origin xyz="-0.00192512550717041 -0.000689018981572781 0.180449455502325" rpy="0 0 0"/>
      <mass value="15.3937526903884"/>
      <inertia ixx="0.0750822670734706" ixy="-1.74008710174754E-05" ixz="0.000685474144944489"
               iyy="0.0613170241831307" iyz="6.25533060124774E-08" izz="0.0914512222280071"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find forklift_sim)/meshes/base_footprint.STL"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
  </link>

  <joint name="chassis_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="chassis_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.00410075201158157 -0.000757897633767796 0.142190908416036" rpy="0 0 0"/>
      <mass value="14.1404214939912"/>
      <inertia ixx="0.0747083475505852" ixy="-1.74006588509029E-05" ixz="0.00068548387624605"
               iyy="0.0608806077812559" iyz="6.21935967142056E-08" izz="0.0910694710737573"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find forklift_sim)/meshes/base_link.STL"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.796 0.824 0.937 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0.02 0 0.229" rpy="0 0 0"/>
      <geometry>
        <box size="0.58 0.44 0.49"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.465 0 0.0185" rpy="0 0 0"/>
      <geometry>
        <box size="0.31 0.20 0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_link_jt" type="fixed">
    <origin xyz="0 0 0.0465" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="base_link"/>
  </joint>

  <link name="laser">
    <inertial>
      <origin xyz="0.000115099330076085 -3.53742851760819E-06 -0.0130182896779998" rpy="0 0 0"/>
      <mass value="0.10046205077288"/>
      <inertia ixx="3.4201078614869E-05" ixy="-2.1320577894134E-10" ixz="9.73147116599212E-09"
               iyy="3.41937214679315E-05" iyz="-3.62911520310395E-10" izz="4.21147068405955E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find forklift_sim)/meshes/laser.STL"/>
      </geometry>
      <material name="laser_grey">
        <color rgba="0.79 0.82 0.93 1"/>
      </material>
    </visual>
  </link>

  <joint name="laser_jt" type="fixed">
    <origin xyz="0.28225 8.78067717803022E-05 0.529034046554903" rpy="0 0 -3.14159265358979"/>
    <parent link="base_link"/>
    <child link="laser"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0.000845680649576901 0.00075545964761381 -0.00185425295461589" rpy="0 0 0"/>
      <mass value="0.000674678214489439"/>
      <inertia ixx="2.17569992333801E-08" ixy="-2.12091450133379E-12" ixz="-1.04699023147566E-13"
               iyy="1.84912152717305E-08" iyz="3.88608827335339E-13" izz="3.99591926332298E-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find forklift_sim)/meshes/imu_link.STL"/>
      </geometry>
      <material name="imu_grey">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
  </link>

  <joint name="imu_link_jt" type="fixed">
    <origin xyz="0 0.000102250185358699 0.300850993995037" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="zed2">
    <inertial>
      <origin xyz="0.00123592571626313 -0.00445421152338907 -0.000367570735085532" rpy="0 0 0"/>
      <mass value="0.152258317197808"/>
      <inertia ixx="0.000372381871693472" ixy="1.58824301550385E-09" ixz="-3.68658632371617E-07"
               iyy="2.281796048433E-05" iyz="6.47520014252541E-09" izz="0.000374684793958985"/>
    </inertial>
  </link>

  <joint name="zed2_jt" type="fixed">
    <origin xyz="0.295000000000002 0 0.577999999999999" rpy="0 0.872664625997167 0"/>
    <parent link="base_link"/>
    <child link="zed2"/>
  </joint>

  <xacro:zed_camera name="zed2" model="zed2" enable_gnss="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>
  
  <joint name="connect_zed_to_forklift" type="fixed">
    <parent link="zed2" />    
    <child link="zed2_camera_link" /> 
    <origin xyz="${zed_height/2*sin(zed_slope)} 0 ${-zed_height/2*cos(zed_slope)}" rpy="0 ${-zed_slope} 0"/>
  </joint>

  <xacro:macro name="mecanum_wheel" params="name x y roll axis_y">
    <link name="${name}">
      <inertial>
        <origin xyz="6.59720139956077E-06 -0.00302823831675181 -6.00978607157021E-10" rpy="0 0 0"/>
        <mass value="0.288217281634097"/>
        <inertia ixx="8.49296106401835E-05" ixy="1.43015511484317E-08" ixz="-1.1339718810965E-12"
                 iyy="0.000100555669784985" iyz="-7.27729464552934E-13" izz="8.49091110430561E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find forklift_sim)/meshes/${name}.STL"/>
        </geometry>
        <material name="${name}_grey">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_jt" type="continuous">
      <origin xyz="${x} ${y} ${wheel_z}" rpy="${roll} 0 0"/>
      <parent link="base_link"/>
      <child link="${name}"/>
      <axis xyz="0 ${axis_y} 0"/>
      <limit effort="1000.0" velocity="100.0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <gazebo reference="${name}">
      <mu1>${ground_mu}</mu1>
      <mu2>${ground_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"  roll="0"    axis_y="1"/>
  <xacro:mecanum_wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}" roll="${pi}" axis_y="-1"/>
  <xacro:mecanum_wheel name="back_left"   x="${-wheel_x}" y="${wheel_y}"  roll="0"    axis_y="1"/>
  <xacro:mecanum_wheel name="back_right"  x="${-wheel_x}" y="${-wheel_y}" roll="${pi}" axis_y="-1"/>

  <gazebo reference="base_link">
    <mu1>${ground_mu}</mu1>
    <mu2>${ground_mu}</mu2>
  </gazebo>

  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <update_rate>50</update_rate>
      <publish_rate>50</publish_rate>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="wheel_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_jt</joint_name>
      <joint_name>front_right_jt</joint_name>
      <joint_name>back_left_jt</joint_name>
      <joint_name>back_right_jt</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="laser">
    <sensor type="ray" name="lds_lfcd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>